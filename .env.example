ARTIFICIAL_ANALYSIS_API_KEY=

# Modex adapter: do not reuse the data API key for analysis.
# Defaults stay off. Explicit CLI --enable-once is invocation-only.
# Synthetic integration does not grant permission to transmit real data.
# The page and preview modes never read credentials.
# Scheduled --check validates local credentials offline; it sends no requests.
ANALYSIS_ENABLED=false
ANALYSIS_DATA_USE_CONFIRMED=false
ANALYSIS_BASE_URL=https://hk.modex-ai.cloud/v1
ANALYSIS_MODEL=gpt-5.6-sol
ANALYSIS_API_KEY=
